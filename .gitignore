# ============================================================
# Growthive Media — .gitignore
# Owner: Nitin Bharwad
# ============================================================

# ──────────────────────────────────────────────────────────
# Node / Package Managers
# ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ──────────────────────────────────────────────────────────
# Next.js Build & Cache
# ──────────────────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
.next-dev.log
.next-dev.log.err
.next-dev.log*

# ──────────────────────────────────────────────────────────
# TypeScript
# ──────────────────────────────────────────────────────────
*.d.ts.map

# ──────────────────────────────────────────────────────────
# Environment Variables — NEVER commit secrets
# ──────────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem

# ──────────────────────────────────────────────────────────
# Testing & Coverage
# ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
.playwright/

# ──────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────────────────────
# Android / React Native / Mobile
# ──────────────────────────────────────────────────────────
.gradle/
app/build/
*.apk
*.aab
*.keystore
*.jks
local.properties

# ──────────────────────────────────────────────────────────
# Desktop — Tauri / Electron
# ──────────────────────────────────────────────────────────
src-tauri/target/
release/
*.exe
*.msi
*.dmg
*.AppImage

# ──────────────────────────────────────────────────────────
# OS & Editor Artifacts
# ──────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# VS Code (keep .vscode/settings.json if needed, but ignore secrets)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# ──────────────────────────────────────────────────────────
# AI / Agent Local Config (never push agent tool configs)
# ──────────────────────────────────────────────────────────
.claude/
.agents/
.gemini/
.cursor/
.aider*

# ──────────────────────────────────────────────────────────
# Docs (internal working docs — keep README.md committed)
# ──────────────────────────────────────────────────────────
docs/
WORKFLOW_REFERENCE.md

# ──────────────────────────────────────────────────────────
# Miscellaneous
# ──────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
tmp/
temp/
.cache/
